{
  "name": "eco-gemeo-conselheiro",
  "version": "0.1.0",
  "private": true,
  "description": "Gêmeo conselheiro pessoal, privado e orientado por consentimento.",
  "type": "commonjs",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron dist-electron/electron/main.js\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "api:build": "tsc -p tsconfig.api.json",
    "api:start": "npm.cmd run api:build && node --env-file=.env.local dist-api/server.js",
    "build": "npm run build:electron && tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run test && npm run build",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@react-three/fiber": "^9.6.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.13.0",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@types/sql.js": "^1.4.9",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.fifones.conselheiro",
    "productName": "Fifones",
    "asar": true,
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm",
      "scripts/**/*.py"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "scripts/**/*.py",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/fifones-icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
